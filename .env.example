# ==============================================================================
# SONGIFREE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your credentials. Never commit '.env'!
# ==============================================================================

# Server & Dashboard Configuration
PORT=3000
HOST=localhost
DASHBOARD_AUTH_PASSWORD=changeme_in_production

# ------------------------------------------------------------------------------
# Spotify Developer API Credentials
# Create an App at: https://developer.spotify.com/dashboard
# Add Redirect URI: http://localhost:3000/api/spotify/callback
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
# Device name or ID to force playback (optional, leave empty for active device)
SPOTIFY_PREFERRED_DEVICE_NAME=

# ------------------------------------------------------------------------------
# Twitch Chat Integration
# Get an OAuth token at: https://twitchapps.com/tmi/ or via custom bot account
# ------------------------------------------------------------------------------
TWITCH_ENABLED=true
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_BOT_USERNAME=your_bot_or_channel_username
TWITCH_OAUTH_TOKEN=oauth:your_twitch_oauth_token_here

# ------------------------------------------------------------------------------
# Kick Live Chat Integration
# Read-only chat monitoring connects to Kick's WebSocket channel directly
# ------------------------------------------------------------------------------
KICK_ENABLED=true
KICK_CHANNEL_SLUG=your_kick_channel_slug

# ------------------------------------------------------------------------------
# TikTok Live Integration
# Connects to your TikTok live stream via Webcast protocol
# ------------------------------------------------------------------------------
TIKTOK_ENABLED=true
TIKTOK_USERNAME=your_tiktok_username_without_at

# ------------------------------------------------------------------------------
# Song Request & Moderation Engine Settings
# ------------------------------------------------------------------------------
# Cooldown per user in seconds between requests
REQUEST_COOLDOWN_SECONDS=60

# Max allowed song duration in seconds (e.g. 600 = 10 minutes)
MAX_SONG_DURATION_SECONDS=600

# Max number of pending songs in queue
MAX_QUEUE_CAPACITY=50

# Allow or block songs flagged as explicit on Spotify (true / false)
ALLOW_EXPLICIT_CONTENT=false

# Number of votes required in chat to skip a song (0 to disable chat vote-skip)
VOTES_TO_SKIP_THRESHOLD=3

# Sub / VIP / Mod privileges: bypass cooldowns, prioritize in queue
MODERATOR_BYPASS_COOLDOWN=true
VIP_BYPASS_COOLDOWN=false
SUBSCRIBER_BYPASS_COOLDOWN=false
